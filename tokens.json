{
  "primitive": {
    "slate-950": {
      "$value": "#020617",
      "$type": "color"
    },
    "slate-900": {
      "$value": "#0f172a",
      "$type": "color"
    },
    "slate-800": {
      "$value": "#1e293b",
      "$type": "color"
    },
    "white": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "gray-400": {
      "$value": "#94a3b8",
      "$type": "color"
    },
    "green-400": {
      "$value": "#4ade80",
      "$type": "color"
    },
    "red-400": {
      "$value": "#f87171",
      "$type": "color"
    }
  },
  "semantic": {
    "app-bg": {
      "$value": "{primitive.slate-950}",
      "$type": "color"
    },
    "surface-secondary": {
      "$value": "{primitive.slate-900}",
      "$type": "color"
    },
    "surface-primary": {
      "$value": "{primitive.slate-800}",
      "$type": "color"
    },
    "text-display": {
      "$value": "{primitive.white}",
      "$type": "color"
    },
    "text-body": {
      "$value": "{primitive.gray-400}",
      "$type": "color"
    },
    "stock-up": {
      "$value": "{primitive.green-400}",
      "$type": "color"
    },
    "stock-down": {
      "$value": "{primitive.red-400}",
      "$type": "color"
    },
    "chart-grid": {
      "$value": "{primitive.gray-400}",
      "$type": "color"
    },
    "chart-stroke-width": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_FLOAT"
        ]
      },
      "$value": "2",
      "$type": "dimension"
    }
  },
  "typography": {
    "font-family": {
      "$value": "Rubik, sans-serif",
      "$type": "text"
    },
    "weight-bold": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_WEIGHT"
        ]
      },
      "$value": "700",
      "$type": "fontWeights"
    },
    "weight-regular": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_WEIGHT"
        ]
      },
      "$value": "400",
      "$type": "fontWeights"
    },
    "headline": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_SIZE"
        ]
      },
      "$value": "1.75rem",
      "$type": "dimension"
    },
    "body-large": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_SIZE"
        ]
      },
      "$value": "1rem",
      "$type": "dimension"
    },
    "body-small": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_SIZE"
        ]
      },
      "$value": "0.75rem",
      "$type": "dimension"
    }
  }
}
